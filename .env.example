# DART 环境变量模板
# 复制此文件为 .env 并填入实际值

# DeepSeek 官网 API（Chat: deepseek-v4-flash）
# 注册地址: https://platform.deepseek.com，官方直营首 token ~1.8s
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 硅基流动 API（Embedding: BAAI/bge-m3，1024 维）
# 注册地址: https://cloud.siliconflow.cn，免费额度 2000 万 tokens
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key

# JWT 签名密钥（openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# MySQL（开发环境）
MYSQL_ROOT_PASSWORD=dart2024
MYSQL_DATABASE=dart
