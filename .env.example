# DART 环境变量模板
# 复制此文件为 .env 并填入实际值

# DeepSeek API（Chat 模型）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Embedding 服务（本地 Ollama + BGE-M3，无需 API Key）
# Ollama 模型需在容器启动后手动拉取: docker exec dart-embeddings ollama pull bge-m3
# EMBEDDING_API_KEY=not-needed

# JWT 签名密钥（openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# MySQL（开发环境）
MYSQL_ROOT_PASSWORD=dart2024
MYSQL_DATABASE=dart
