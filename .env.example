# DART 环境变量模板
# 复制此文件为 .env 并填入实际值

# DeepSeek API（Chat 模型）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI API（Embedding 模型 text-embedding-3-small，输出 1536 维）
OPENAI_API_KEY=sk-your-openai-api-key

# JWT 签名密钥（openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# MySQL（开发环境）
MYSQL_ROOT_PASSWORD=dart2024
MYSQL_DATABASE=dart
